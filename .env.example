# OrderlyApp environment defaults
# Copy this file to .env.local for local Next.js development or to .env for Docker Compose.
# Values below are safe placeholders only. Do not commit real credentials or secrets.

# Public frontend URL used by docs, deployment health checks, and any absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Legacy/public API URL kept for compatibility. Browser requests use the same-origin /api/orderly gateway.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only fixed upstream origin for the Next.js /api/orderly gateway.
ORDERLY_API_ORIGIN=http://127.0.0.1:8000

# Browser speech capture mode. Allowed values: browser | mock.
NEXT_PUBLIC_VOICE_MODE=browser

# Checkout behavior. Allowed values: mock | disabled. No real payments are collected in this app.
NEXT_PUBLIC_CHECKOUT_MODE=mock

# Auth provider placeholder. Allowed values: none | mock | clerk | auth0.
# Keep as none until account/auth flows are implemented.
NEXT_PUBLIC_AUTH_PROVIDER=none

# Server-only auth secret placeholder for future account providers. Leave empty for local demo mode.
AUTH_SECRET=

# Runtime identity and evidence. Production-like services should set production.
ORDERLY_ENVIRONMENT=development
# Optional exact source identity for local/container evidence. Render provides RENDER_GIT_COMMIT automatically.
ORDERLY_SOURCE_SHA=local

# ST-02 guest identity. API mode is required for server-issued guest sessions.
ORDERLY_DATA_MODE=api
# Generate a private value with at least 32 bytes, for example: openssl rand -hex 32
ORDERLY_SESSION_SECRET=
# Exact browser origins permitted to perform guest/session mutations. No paths or wildcards.
ORDERLY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend persistence for running FastAPI outside Docker Compose.
DATABASE_URL=postgresql://orderly:orderly@localhost:5432/orderlyapp
REDIS_URL=redis://localhost:6379

# Checkout abuse bounds. Redis stores only short-lived counters, never order authority.
ORDERLY_CHECKOUT_RATE_WINDOW_SECONDS=60
ORDERLY_CHECKOUT_RATE_LIMIT_PER_GUEST=10
ORDERLY_CHECKOUT_RATE_LIMIT_AGGREGATE=120

# Scheduled anonymous guest retention job. One SQL batch is always capped at 100 rows.
# This only limits how many batches a single cleanup invocation can drain.
ORDERLY_CLEANUP_MAX_BATCHES=1000

# Fixture seeding is deliberately disabled by default. Enable it only for an explicit
# development/test/preview seed command. Never set this to 1 in production serving config.
ORDERLY_ALLOW_FIXTURE_SEED=0

# Set to 1 to force the backend JSON fallback store even when database services are configured.
# ST-02 guest sessions require PostgreSQL and will fail closed when storage is unavailable.
ORDERLY_FORCE_JSON_STORE=0

# Comma-separated frontend origins allowed by FastAPI CORS.
ORDERLY_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000

# Docker Compose local defaults.
ORDERLY_COMPOSE_APP_URL=http://localhost:3100
# The API container uses internal service URLs by default via docker-compose.yml.
# Override these only if you intentionally point Compose at external services.
ORDERLY_COMPOSE_DATABASE_URL=postgresql://orderly:orderly@postgres:5432/orderlyapp
ORDERLY_COMPOSE_REDIS_URL=redis://redis:6379
POSTGRES_DB=orderlyapp
POSTGRES_USER=orderly
POSTGRES_PASSWORD=orderly
