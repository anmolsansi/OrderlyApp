# OrderlyApp environment defaults
# Copy this file to .env.local for local Next.js development or to .env for Docker Compose.
# Values below are safe placeholders only. Do not commit real credentials or secrets.

# Public frontend URL used by docs, deployment health checks, and any absolute links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public FastAPI URL used by the Next.js frontend. Use http://localhost:8000 for local dev.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Browser speech capture mode. Allowed values: browser | mock.
NEXT_PUBLIC_VOICE_MODE=browser

# Checkout behavior. Allowed values: mock | disabled. No real payments are collected in this app.
NEXT_PUBLIC_CHECKOUT_MODE=mock

# Auth provider placeholder. Allowed values: none | mock | clerk | auth0.
# Keep as none until account/auth flows are implemented.
NEXT_PUBLIC_AUTH_PROVIDER=none

# Server-only auth secret placeholder for future providers. Leave empty for local demo mode.
AUTH_SECRET=

# Backend persistence for running FastAPI outside Docker Compose.
DATABASE_URL=postgresql://orderly:orderly@localhost:5432/orderlyapp
REDIS_URL=redis://localhost:6379

# Set to 1 to force the backend JSON fallback store even when database services are configured.
ORDERLY_FORCE_JSON_STORE=0

# Comma-separated frontend origins allowed by FastAPI CORS.
ORDERLY_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000

# Docker Compose local defaults.
ORDERLY_COMPOSE_APP_URL=http://localhost:3100
# The API container uses internal service URLs by default via docker-compose.yml.
# Override these only if you intentionally point Compose at external services.
ORDERLY_COMPOSE_DATABASE_URL=postgresql://orderly:orderly@postgres:5432/orderlyapp
ORDERLY_COMPOSE_REDIS_URL=redis://redis:6379
POSTGRES_DB=orderlyapp
POSTGRES_USER=orderly
POSTGRES_PASSWORD=orderly
