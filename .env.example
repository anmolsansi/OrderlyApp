# OrderlyApp environment defaults

# Public app URL used by frontend/deployment docs
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Browser speech capture mode: browser | mock
NEXT_PUBLIC_VOICE_MODE=browser

# Public FastAPI URL used by the Next.js frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend persistence
DATABASE_URL=postgresql://orderly:orderly@localhost:5432/orderlyapp
REDIS_URL=redis://localhost:6379

# Comma-separated frontend origins allowed by FastAPI CORS
ORDERLY_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000

# Docker Compose local defaults
# The API container uses internal service URLs by default via docker-compose.yml.
# Override these only if you intentionally point Compose at external services.
ORDERLY_COMPOSE_DATABASE_URL=postgresql://orderly:orderly@postgres:5432/orderlyapp
ORDERLY_COMPOSE_REDIS_URL=redis://redis:6379
POSTGRES_DB=orderlyapp
POSTGRES_USER=orderly
POSTGRES_PASSWORD=orderly
